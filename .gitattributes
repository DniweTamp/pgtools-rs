# Normalize line endings in the repo to LF, and check out LF by default.
# Windows scripts keep CRLF so cmd.exe / PowerShell handle them natively.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and data files (explicit for clarity)
*.rs    text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Binary assets - never diff or convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.pdb  binary
