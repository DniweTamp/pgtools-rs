# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
# Build output (workspace root and any nested crate target dirs)
/target/
**/target/

# Cargo/rustc scratch & backups
**/*.rs.bk
*.pdb
*.dSYM/
*.dSYM.zip
*.profraw
*.profdata
incremental/

# Cargo.lock is intentionally committed: this workspace ships binaries.

# ---------------------------------------------------------------------------
# Node / Vite / Tauri frontend
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/

# Vite / frontend build output
dist/
dist-ssr/
.vite/
*.local

# Logs & package-manager caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
# Generated by the Tauri CLI
crates/pgtools-gui/src-tauri/gen/schemas/
**/src-tauri/gen/schemas/
**/src-tauri/target/

# Bundled installers / app packages
*.app/
*.dmg
*.msi
*.msix
*.appx
*.AppImage
*.deb
*.rpm
**/bundle/

# ---------------------------------------------------------------------------
# This project's release artifacts
# ---------------------------------------------------------------------------
# Staged release folders, zips and standalone binaries produced by
# scripts/package-release.ps1
/dist/
/release/
/*.zip
/PGTools-Studio-Source.zip

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.sw?
*~

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
